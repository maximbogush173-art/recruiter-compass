    {
      "id": "ctx-criteria",
      "name": "Прочитать подтверждённые критерии",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput",
      "position": [
        336,
        272
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT criteria_version_id, criteria FROM recruiter_compass.vacancy_criteria_versions WHERE potok_vacancy_id = $1 AND status = 'confirmed' ORDER BY version_number DESC LIMIT 1",
        "options": {
          "queryReplacement": "={{ $('Получить вход инструмента').first().json.vacancy_id }}"
        }
      },
      "credentials": {
        "postgres": {
