        "language": "javaScript",
        "jsCode": "const row = $input.first().json;\nconst all = (row && row.objects && row.objects.jobs) || [];\nconst active = all.filter(function(j) { return j.archived === false && j.state_id === 'opened' && String(j.name || '').indexOf('TEST') < 0 && String(j.name || '').indexOf('PROBE') < 0; });\nreturn [{ json: { vacancies: active.map(function(j) { return { id: j.id, name: j.name }; }) } }];"
