    {
      "id": "8f953255-858d-4c64-bcbe-9e87cebd19af",
      "name": "Валидировать и собрать SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        208
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst vacancy = $('Нормализовать снимок').first().json;\nconst vacancyId = vacancy.vacancy_id;\nconst vacancyName = vacancy.vacancy_name;\nreturn items.map(function(item) {\n  const o = item.json.output || {};\n  const errors = [];\n  const criteria = o.criteria;\n  if (!Array.isArray(criteria) || criteria.length === 0) { errors.push('criteria: пусто или не массив'); }\n  else { criteria.forEach(function(c, i) {\n    if (!c || !/^C[0-9]+$/.test(c.criterion_id || '')) { errors.push('criteria[' + i + '].criterion_id'); }\n    if (!c || ['must_have','nice_to_have','constraint'].indexOf(c.kind) < 0) { errors.push('criteria[' + i + '].kind'); }\n    if (!c || !c.title || !c.verification_rule || !c.why_it_matters) { errors.push('criteria[' + i + ']: нет обязательного поля'); }\n  }); }\n  if (!Array.isArray(o.ambiguous_phrases_replaced)) { errors.push('ambiguous_phrases_replaced: не массив'); }\n  if (!Array.isArray(o.questions_for_hiring_manager)) { errors.push('questions_for_hiring_manager: не массив'); }\n  const valid = errors.length === 0;\n  const criteriaJson = JSON.stringify(criteria || []);\n  const criteriaSql = \"'\" + criteriaJson.replace(/'/g, \"''\") + \"'\";\n  const sql = \"WITH new_run AS (INSERT INTO recruiter_compass.agent_runs (workflow_key, trigger_source, status, potok_vacancy_id, model_provider, model_name, prompt_version) VALUES ('generate_criteria','webhook','succeeded',\" + vacancyId + \",'deepseek','deepseek-chat','vacancy-criteria-v1') RETURNING run_id) INSERT INTO recruiter_compass.vacancy_criteria_versions (potok_vacancy_id, version_number, status, criteria, source_run_id) SELECT \" + vacancyId + \",(SELECT COALESCE(MAX(version_number),0)+1 FROM recruiter_compass.vacancy_criteria_versions WHERE potok_vacancy_id = \" + vacancyId + \"),'proposed',\" + criteriaSql + \"::jsonb, run_id FROM new_run RETURNING criteria_version_id\";\n  return { json: { valid: valid, errors: errors, criteria: criteria || [], ambiguous_phrases_replaced: o.ambiguous_phrases_replaced || [], questions_for_hiring_manager: o.questions_for_hiring_manager || [], vacancy_id: vacancyId, vacancy_name: vacancyName, sql: sql } };\n});"
      }
    },
