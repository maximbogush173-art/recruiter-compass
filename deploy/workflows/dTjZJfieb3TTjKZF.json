    {
      "id": "c0b3c0a7-8531-4ab9-8fed-9fd894b84f2f",
      "name": "Валидировать и собрать SQL 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        800
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst vacancyId = Number($('Валидировать вход').first().json.vacancy_id);\nreturn items.map(function(item) {\n  const o = item.json.output || {};\n  const criteria = o.criteria;\n  const valid = Array.isArray(criteria) && criteria.length > 0 && criteria.every(function(c) { return c && /^C[0-9]+$/.test(c.criterion_id || '') && ['must_have','nice_to_have','constraint'].indexOf(c.kind) >= 0 && c.title && c.verification_rule && c.why_it_matters; });\n  const criteriaJson = JSON.stringify(criteria || []);\n  const criteriaSql = \"'\" + criteriaJson.replace(/'/g, \"''\") + \"'\";\n  const sql = valid ? \"WITH new_run AS (INSERT INTO recruiter_compass.agent_runs (workflow_key, trigger_source, status, potok_vacancy_id, model_provider, model_name, prompt_version) VALUES ('regenerate_criteria','webhook','succeeded',\" + vacancyId + \",'deepseek','deepseek-chat','vacancy-criteria-v1') RETURNING run_id) INSERT INTO recruiter_compass.vacancy_criteria_versions (potok_vacancy_id, version_number, status, criteria, source_run_id) SELECT \" + vacancyId + \",(SELECT COALESCE(MAX(version_number),0)+1 FROM recruiter_compass.vacancy_criteria_versions WHERE potok_vacancy_id = \" + vacancyId + \"),'proposed',\" + criteriaSql + \"::jsonb, run_id FROM new_run RETURNING criteria_version_id\" : \"SELECT 1\";\n  return { json: { valid: valid, criteria: criteria || [], sql: sql } };\n});"
      }
    },
