    {
      "id": "60332047-3d46-4a38-bdc4-e72cb2d676f5",
      "name": "Переработать критерии",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1120,
