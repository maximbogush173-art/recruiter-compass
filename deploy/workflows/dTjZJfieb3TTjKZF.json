    {
      "id": "1382fbf1-2a7a-4ec8-a3fe-729728c36c22",
      "name": "Собрать SQL подтверждения",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        608
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const vacancyId = Number($('Валидировать вход').first().json.vacancy_id);\nif (!vacancyId) { throw new Error('confirm_criteria требует vacancy_id'); }\nconst sql = \"WITH target AS (SELECT criteria_version_id FROM recruiter_compass.vacancy_criteria_versions WHERE potok_vacancy_id = \" + vacancyId + \" AND status = 'proposed' ORDER BY version_number DESC LIMIT 1), old AS (UPDATE recruiter_compass.vacancy_criteria_versions SET status = 'superseded' WHERE potok_vacancy_id = \" + vacancyId + \" AND status = 'confirmed') UPDATE recruiter_compass.vacancy_criteria_versions SET status = 'confirmed', confirmed_by = 'recruiter', confirmed_at = now() WHERE criteria_version_id = (SELECT criteria_version_id FROM target) RETURNING criteria_version_id, potok_vacancy_id, version_number, status\";\nreturn [{ json: { sql: sql } }];"
      }
    },
