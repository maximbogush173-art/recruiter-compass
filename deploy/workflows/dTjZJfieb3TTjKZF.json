      "id": "19d648d8-47ca-40be-9530-c341cdb009dd",
      "name": "Валидировать и собрать SQL 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        992
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const params = $('Валидировать вход').first().json;\nconst vacancyId = Number(params.vacancy_id);\nconst editedCriteria = Array.isArray(params.criteria) ? params.criteria : [];\nif (!vacancyId || editedCriteria.length === 0) { throw new Error('edit_criteria требует vacancy_id и criteria'); }\nconst errors = [];\neditedCriteria.forEach(function(c, i) {\n  if (!c || !/^C[0-9]+$/.test(c.criterion_id || '')) { errors.push('criterion_id[' + i + ']'); }\n  if (!c || ['must_have','nice_to_have','constraint'].indexOf(c.kind) < 0) { errors.push('kind[' + i + ']'); }\n  if (!c || !c.title || !c.verification_rule || !c.why_it_matters) { errors.push('поле[' + i + ']'); }\n});\nconst valid = errors.length === 0;\nconst criteriaJson = JSON.stringify(editedCriteria);\nconst criteriaSql = \"'\" + criteriaJson.replace(/'/g, \"''\") + \"'\";\nconst sql = valid ? \"WITH new_run AS (INSERT INTO recruiter_compass.agent_runs (workflow_key, trigger_source, status, potok_vacancy_id, model_provider, model_name, prompt_version) VALUES ('edit_criteria','webhook','succeeded',\" + vacancyId + \",'manual','manual','vacancy-criteria-v1') RETURNING run_id) INSERT INTO recruiter_compass.vacancy_criteria_versions (potok_vacancy_id, version_number, status, criteria, source_run_id) SELECT \" + vacancyId + \",(SELECT COALESCE(MAX(version_number),0)+1 FROM recruiter_compass.vacancy_criteria_versions WHERE potok_vacancy_id = \" + vacancyId + \"),'proposed',\" + criteriaSql + \"::jsonb, run_id FROM new_run RETURNING criteria_version_id\" : \"\";\nreturn [{ json: { valid: valid, errors: errors, criteria: editedCriteria, sql: sql } }];"
      }
    },
