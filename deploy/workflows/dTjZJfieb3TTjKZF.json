      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\nconst intent = String(body.intent || '');\nconst vacancyId = Number(body.vacancy_id);\nconst criteria = Array.isArray(body.criteria) ? body.criteria : null;\nconst feedback = String(body.feedback || 'Критериев слишком много. Оставь обязательные и ключевые, убери дубли и лишние ограничения.');\nif (!intent) { throw new Error('Вход требует intent'); }\nreturn [{ json: { intent: intent, vacancy_id: vacancyId, criteria: criteria, feedback: feedback } }];"
      }
