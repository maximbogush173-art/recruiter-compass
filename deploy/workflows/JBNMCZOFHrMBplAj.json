      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const a = $input.first().json;\nconst resumes = Array.isArray(a.resumes) ? a.resumes : [];\nlet latest = null;\nresumes.forEach(function(r) { if (!latest || r.id > latest.id) { latest = r; } });\nconst cv = (latest && latest.cv_params) || {};\nconst expText = (cv.experience || []).map(function(e) { return e.company + ' — ' + e.position + ': ' + (e.description || ''); }).join(' ');\nconst resumeText = [cv.about_me, expText, cv.skills].filter(function(s) { return s; }).join(' ');\nreturn [{ json: { applicant_id: a.id, name: a.name || '', resume_text: resumeText } }];"
      }
    }
