      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\nconst intent = String(body.intent || '');\nconst candidateId = Number(body.candidate_id);\nconst vacancyId = Number(body.vacancy_id);\nconst transcript = String(body.transcript || '');\nconst feedback = String(body.feedback || '');\nif (!intent) { throw new Error('Вход требует intent'); }\nconst review_sql = \"SELECT review_id, potok_candidate_id, evidence, recommendation, summary FROM recruiter_compass.candidate_reviews WHERE potok_vacancy_id = \" + vacancyId + \" AND potok_candidate_id = \" + candidateId + \" ORDER BY created_at DESC LIMIT 1\";\nconst veto_review_sql = \"SELECT review_id, potok_candidate_id, evidence FROM recruiter_compass.candidate_reviews WHERE potok_vacancy_id = \" + vacancyId + \" AND potok_candidate_id = \" + candidateId + \" AND recommendation = 'consider_neighbour_role' ORDER BY created_at DESC LIMIT 1\";\nreturn [{ json: { intent: intent, candidate_id: candidateId, vacancy_id: vacancyId, transcript: transcript, feedback: feedback, review_sql: review_sql, veto_review_sql: veto_review_sql } }];"
      }
    },
