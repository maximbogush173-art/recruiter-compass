        "jsCode": "const review = $('Текущий разбор').first().json;\nconst params = $('Валидировать вход').first().json;\nconst input = 'Текущий разбор по критериям (JSON): ' + JSON.stringify(review.evidence) + '\\n\\nРасшифровка интервью:\\n' + params.transcript;\nreturn [{ json: { candidate_id: String(review.potok_candidate_id), review_input: input } }];"
