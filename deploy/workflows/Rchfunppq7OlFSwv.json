    {
      "id": "cf52e96b-3627-49ee-9c42-fcc0c355742d",
      "name": "Слить факты и SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        208
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const review = $('Текущий разбор').first().json;\nconst parsed = $('Разобрать расшифровку').first().json;\nconst out = parsed.output || {};\nconst newEvidence = out.new_evidence || [];\nconst merged = (review.evidence || []).map(function(a) {\n  const upd = newEvidence.find(function(n) { return n.criterion_id === a.criterion_id; });\n  if (!upd) { return a; }\n  const nonTranscript = (a.evidence || []).filter(function(ev) { return ev.source_type !== 'transcript'; });\n  return { criterion_id: a.criterion_id, state: upd.state, claim: upd.claim, evidence: nonTranscript.concat(upd.evidence || []), contradictions: a.contradictions || [] };\n});\nnewEvidence.forEach(function(n) { if (!merged.some(function(m) { return m.criterion_id === n.criterion_id; })) { merged.push({ criterion_id: n.criterion_id, state: n.state, claim: n.claim, evidence: n.evidence || [], contradictions: [] }); } });\nconst esc = function(s) { return String(s).replace(/'/g, \"''\"); };\nconst sql = \"UPDATE recruiter_compass.candidate_reviews SET evidence = '\" + esc(JSON.stringify(merged)) + \"'::jsonb WHERE review_id = '\" + esc(String(review.review_id)) + \"'\";\nreturn [{ json: { sql: sql, candidate_id: String(review.potok_candidate_id), closed_gaps: out.closed_gaps || [], remaining_gaps: out.remaining_gaps || [], summary: out.summary || '' } }];"
      }
    },
