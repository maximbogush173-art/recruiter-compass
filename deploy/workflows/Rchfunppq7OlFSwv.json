      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const review = $('Разбор кандидата').first().json;\nconst parsed = $('Классифицировать отзыв').first().json;\nconst out = parsed.output || {};\nconst vetoType = out.veto_type || 'professional_rejection';\nlet nextAction = 'close_rejection';\nlet recommendation = 'not_for_current_vacancy';\nif (vetoType === 'team_fit_veto') { nextAction = 'find_neighbour'; recommendation = 'consider_neighbour_role'; }\nconst esc = function(s) { return String(s).replace(/'/g, \"''\"); };\nconst sql = \"UPDATE recruiter_compass.candidate_reviews SET recommendation = '\" + esc(recommendation) + \"', summary = '\" + esc(out.summary || '') + \"' WHERE review_id = '\" + esc(String(review.review_id)) + \"'\";\nreturn [{ json: { sql: sql, candidate_id: String(review.potok_candidate_id), veto_type: vetoType, recommendation: recommendation, next_action: nextAction } }];"
