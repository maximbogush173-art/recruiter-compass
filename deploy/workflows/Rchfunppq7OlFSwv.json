      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const review = $('veto-разбор').first().json;\nconst jobsRow = $('Все вакансии').first().json;\nconst resume = $('Нормализовать резюме').first().json;\nconst sourceVacancyId = Number($('Валидировать вход').first().json.vacancy_id);\nconst allJobs = (jobsRow && jobsRow.objects && jobsRow.objects.jobs) || [];\nconst strip = function(s) { return String(s || '').replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim(); };\nconst candidates = allJobs.filter(function(j) { return j.archived === false && j.state_id === 'opened' && Number(j.id) !== sourceVacancyId; });\nconst facts = (review.evidence || []).map(function(a) { return { criterion: a.criterion_id, state: a.state, claim: a.claim, evidence: a.evidence || [] }; });\nconst jobsBlock = candidates.map(function(j) { return 'Вакансия id=' + j.id + ' «' + (j.name || '') + '»:\\n' + strip(j.description); }).join('\\n\\n');\nconst input = 'Имя кандидата: ' + (resume.name || '') + '\\n\\nУже извлечённые факты кандидата (JSON): ' + JSON.stringify(facts) + '\\n\\nРезюме (для недостающих фактов): ' + (resume.resume_text || '') + '\\n\\nСписок вакансий для оценки:\\n' + jobsBlock;\nreturn [{ json: { candidate_id: String(review.potok_candidate_id), review_id: String(review.review_id), fit_input: input } }];"
      }
    },
    {
      "id": "bb30d076-f56f-4031-a737-8cc1707f15ea",
