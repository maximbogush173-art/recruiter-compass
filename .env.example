# ---------------------------------------------------------------------------
# «Компас рекрутера» — переменные облачного контура.
# Скопируйте в .env (в корне репозитория) и заполните. .env НЕ коммитится.
# ---------------------------------------------------------------------------

# Пароль пользователя `compass` в Postgres-контейнере. Сгенерируйте:
#   openssl rand -hex 16
COMPASS_DB_PASSWORD=

# Ключ шифрования учётных данных n8n. Сгенерируйте:
#   openssl rand -hex 32
COMPASS_N8N_ENCRYPTION_KEY=

# Часовой пояс.
TZ=Europe/Moscow
