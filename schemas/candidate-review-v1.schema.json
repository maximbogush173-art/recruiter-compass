{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CandidateReviewV1",
  "description": "Разбор кандидата по подтверждённым критериям (v1). state не сворачивается в score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "assessments", "critical_unknowns", "next_action", "reasoning_summary"],
  "properties": {
    "candidate_id": { "type": "string" },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "state", "claim", "evidence"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^C[0-9]+$" },
          "state": { "type": "string", "enum": ["confirmed", "partially_confirmed", "needs_clarification", "not_met"] },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_type", "source_ref", "quote"],
              "properties": {
                "source_type": { "type": "string", "enum": ["resume", "transcript", "feedback", "potok"] },
                "source_ref": { "type": "string", "minLength": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          },
          "contradictions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "critical_unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "question", "why_now"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^C[0-9]+$" },
          "question": { "type": "string", "minLength": 1 },
          "why_now": { "type": "string" }
        }
      }
    },
    "next_action": { "type": "string", "enum": ["continue", "clarify", "not_for_current_role", "consider_neighbour_role"] },
    "reasoning_summary": { "type": "string" }
  }
}
