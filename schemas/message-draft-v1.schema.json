{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessageDraftV1",
  "description": "Черновик сообщения кандидату (v1). Всегда черновик, никогда не отправляется автоматически.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "facts_included"],
  "properties": {
    "subject": { "type": "string" },
    "body": { "type": "string", "minLength": 1 },
    "facts_included": { "type": "array", "items": { "type": "string" } },
    "promises_made": { "type": "array", "items": { "type": "string" } }
  }
}
