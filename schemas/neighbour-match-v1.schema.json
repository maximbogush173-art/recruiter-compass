{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NeighbourMatchV1",
  "description": "Матч подтверждённых фактов кандидата с открытыми вакансиями (v1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["matches", "summary"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vacancy_id", "vacancy_name", "confirmed_criteria", "remaining_gaps"],
        "properties": {
          "vacancy_id": { "type": "string" },
          "vacancy_name": { "type": "string" },
          "confirmed_criteria": { "type": "array", "items": { "type": "string" } },
          "remaining_gaps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "recommended_vacancy_id": { "type": ["string", "null"] },
    "summary": { "type": "string" }
  }
}
