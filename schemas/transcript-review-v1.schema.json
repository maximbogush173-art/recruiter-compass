{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranscriptReviewV1",
  "description": "Извлечение новых/исправляющих фактов из расшифровки интервью (v1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["new_evidence", "affected_criteria", "closed_gaps", "remaining_gaps", "summary"],
  "properties": {
    "new_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "state", "claim", "evidence"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^C[0-9]+$" },
          "state": { "type": "string", "enum": ["confirmed", "partially_confirmed", "needs_clarification", "not_met"] },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_type", "source_ref", "quote"],
              "properties": {
                "source_type": { "type": "string", "enum": ["transcript"] },
                "source_ref": { "type": "string", "minLength": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "affected_criteria": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]+$" } },
    "closed_gaps": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]+$" } },
    "remaining_gaps": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]+$" } },
    "summary": { "type": "string" }
  }
}
