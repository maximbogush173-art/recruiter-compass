{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VacancyCriteriaV1",
  "description": "Детерминированная схема ответа модели для workflow «Сформировать критерии вакансии» (v1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "ambiguous_phrases_replaced", "questions_for_hiring_manager"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "title", "kind", "verification_rule", "why_it_matters"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "title": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["must_have", "nice_to_have", "constraint"]
          },
          "verification_rule": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ambiguous_phrases_replaced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_phrase", "replacement"],
        "properties": {
          "source_phrase": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions_for_hiring_manager": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
